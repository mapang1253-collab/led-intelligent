{
  "$schema": "node_modules/wrangler/config-schema.json",
  // TODO(day 1): rename to your actual Cloudflare Workers project name.
  "name": "reis-web",
  "main": "./src/worker/index.ts",
  // TODO(day 1): set to today's date once `wrangler` is installed (`npx wrangler --version` prints
  // the latest supported value). Pin it; do not "always use latest".
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  // Hyperdrive config "reis-db", created 2026-09-15 (Cloudflare account
  // knsurattanaporn@gmail.com), pointing at the Supabase direct-connection Postgres. The ID is not a
  // secret; the underlying DB password is (lives only in apps/web/.dev.vars, never here).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "469d366a5414404c896ddbe752b18f02" }]
  // --- R2 stays disabled until a source needs raw-object storage rights (docs/data-architecture.md §8).
  // "r2_buckets": [
  //   { "binding": "RAW_OBJECTS", "bucket_name": "<r2-bucket-name>" }
  // ]
}
