# Copy to .dev.vars (same directory) and fill in real values. .dev.vars is git-ignored — never commit it.
# No secret may use the public VITE_ prefix (docs/technology-stack.md §13).

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AI_DISABLED (default) | RECORDED_AI | LIVE_AI — docs/ai-architecture.md §5.
# LIVE_AI sends bounded, de-identified context to Google. Do not enable it until the provider's
# data-use terms have been reviewed and recorded (docs/ai-architecture.md §6-7).
AI_MODE=AI_DISABLED

# Gemini quota facts recorded from your Google AI Studio project (docs/technology-stack.md §10).
GEMINI_RPM_LIMIT=
GEMINI_TPM_LIMIT=
GEMINI_RPD_LIMIT=
AI_DAILY_RESERVE_PERCENT=20

# Supabase Postgres connection string (Supabase dashboard → Connect → Direct connection → URI).
# Wrangler's Hyperdrive local-dev emulation reads this exact variable name: it must be
# WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_<binding name> — our binding is "HYPERDRIVE"
# (apps/web/wrangler.jsonc), so the variable is:
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://

# Random 32+ byte value used to sign/digest the anonymous run capability (docs/security-privacy-compliance.md §3).
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
RUN_CAPABILITY_SECRET=
