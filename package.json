{
  "name": "real-estate-investment-system",
  "private": true,
  "version": "0.0.0",
  "description": "Thailand-wide, property-centred Highest-and-Best-Use analysis web application (university project).",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "setup:check": "node ./tools/setup-check.mjs",
    "dev": "pnpm --filter @reis/web dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @reis/web test:e2e",
    "benchmark": "pnpm --filter @reis/web benchmark",
    "deploy": "pnpm --filter @reis/web deploy",
    "db:migrate": "pnpm --filter @reis/data-access run db:migrate",
    "db:seed:reference": "pnpm --filter @reis/data-access run db:seed:reference",
    "db:seed:academic": "pnpm --filter @reis/data-access run db:seed:academic",
    "build:adapters": "pnpm --filter @reis/source-adapters run build",
    "ingest:nso-ses-income": "pnpm run build:adapters && node --env-file=apps/web/.env.migration tools/ingestion/ingest-nso-ses-income.mjs",
    "source:activate": "node --env-file=apps/web/.env.migration tools/ingestion/activate-source.mjs",
    "ingest:dopa-population": "pnpm run build:adapters && node --env-file=apps/web/.env.migration tools/ingestion/ingest-dopa-population.mjs",
    "pack:review": "node tools/ingestion/review-pack.mjs",
    "ai:budget": "node --env-file=apps/web/.dev.vars tools/ingestion/ai-budget.mjs",
    "purge:expired": "node --env-file=apps/web/.env.migration tools/ingestion/purge-expired.mjs",
    "ingest:treasury-building": "pnpm run build:adapters && node --env-file=apps/web/.env.migration tools/ingestion/ingest-treasury-building-valuation.mjs",
    "valuation:review": "node tools/ingestion/review-valuation.mjs",
    "ingest:treasury-condo": "pnpm run build:adapters && node --env-file=apps/web/.env.migration tools/ingestion/ingest-treasury-condominium-valuation.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "pg": "^8.13.1",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@google/genai",
      "esbuild",
      "protobufjs",
      "sharp",
      "workerd"
    ]
  }
}
